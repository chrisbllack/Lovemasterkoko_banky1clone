# Banky Hotel & Suites - Environment Configuration
# Note: Firebase client credentials and Firestore Database ID are auto-loaded directly
# from firebase-applet-config.json, so manual NEXT_PUBLIC_FIREBASE_* variables are NOT required.

# Optional: Paystack Secret Key for online card payments (Bank transfer & Front-Desk settlements work out of the box)
# PAYSTACK_SECRET_KEY=sk_test_...

# Optional: Firebase Admin Service Account JSON string for elevated server-side actions
# FIREBASE_SERVICE_ACCOUNT_JSON=
