rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) ||
        request.auth.token.email == 'bankyhotelado@gmail.com' ||
        request.auth.token.email == 'chrisbllack@gmail.com' ||
        request.auth.token.email == 'admin@bankyhotelandsuites.com' ||
        request.auth.token.email == 'chrisbllackaidev@gmail.com' ||
        request.auth.token.email == 'infinityplussolutionsss@gmail.com'
      );
    }

    // ── Default Deny ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Connection Test Probe (Mandatory Skill Guideline) ───────────
    match /test/{testId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── Public Hotel Information & Catalog ───────────────────────────
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /properties/{propId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isStaff();
      match /dailyAvailability/{date} {
        allow read: if isStaff();
        allow write: if isStaff();
      }
    }

    match /room_types/{roomTypeId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /physical_rooms/{roomId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /rate_plans/{planId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /rate_rules/{ruleId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /inventory_blocks/{blockId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /addons/{addonId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /gallery_images/{imageId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ── Guest Interactions: Bookings, Reviews, Orders & Subscriptions ─
    match /reservations/{reservationId} {
      allow create, read, update: if true;
      allow delete: if isStaff();
    }

    match /booking_holds/{holdId} {
      allow read, write: if true;
    }

    match /booking_quotes/{quoteId} {
      allow read, write: if true;
    }

    match /idempotency_keys/{keyId} {
      allow read, write: if true;
    }

    match /webhook_events/{eventId} {
      allow read, write: if true;
    }

    match /counters/{counterId} {
      allow read, write: if true;
    }

    match /inventory_locks/{lockId} {
      allow read, write: if true;
    }

    match /guests/{guestId} {
      allow create, read, update: if true;
      allow delete: if isStaff();
    }

    match /payments/{paymentId} {
      allow create, read, update: if true;
      allow delete: if isStaff();
    }

    match /refunds/{refundId} {
      allow read, write: if isStaff();
    }

    match /newsletter_subscribers/{subId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    match /guest_reviews/{reviewId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isStaff();
    }

    match /messages/{messageId} {
      allow read, create: if isSignedIn() || isStaff();
      allow update, delete: if isStaff();
    }

    match /folios/{folioId} {
      allow read, write: if isStaff();
    }

    match /folio_charges/{chargeId} {
      allow read, write: if isStaff();
    }

    match /integration_events/{eventId} {
      allow read, write: if isStaff();
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if false;
    }

    match /user_roles/{userId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow write: if isSignedIn() && (request.auth.uid == userId || isStaff());
    }

    // ── QR Dining & In-Room Service ─────────────────────────────────
    match /menu_categories/{catId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /qr_orders/{orderId} {
      allow create, read, update: if true;
      allow delete: if isStaff();
    }
  }
}
